{% block title %}
    <title>Ajouter une serie </title>
{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}

    <div class="formulaire">

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}


        <h2 class="connect"> Ajouter une serie</h2>

            {{ form_row(form.titre, {
                'label': 'Titre :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.description, {
                'label': 'Description :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.genre, {
                'label': 'Choisissez un genre :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.dateDeSortie, {
                'label': 'Date de sortie :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.duree, {
                'label': 'Durée (en minutes) :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.realisateurs, {
                'label': 'Réalisateurs :',
                'attr': {'class': 'mon-input'}
            }) }}

        {# Champ pour uploader l’affiche #}
            {{ form_row(form.affiche, {
                'label': 'Affiche de la serie', 'attr': {'class': 'file'}
            }) }}


        {{ form_end(form) }}
        <button type="submit" class="btn">
            Ajouter la serie
        </button>

        <a href="{{ path('app_profile') }}" class="btn">← Retour à la liste</a>

    </div>


{% endblock %}
