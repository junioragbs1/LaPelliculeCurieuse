{% block title %}
    <title>Contacts</title>
{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
{% endblock %}

{% block body %}
    <div class="text-center">
        <h2>Contactez-nous</h2>
        <p>Pour toute question ou suggestion, n'hésitez pas à nous contacter :</p>
    </div>
    <section class="contact">
        <div class="text-center">
            <h3>Informations de contact :</h3>
            <p>Email : contact@example.com</p>
            <p>Téléphone : +33 1 23 45 67 89</p>
        </div>
        <div class="text-center">
            <details>
                <summary><h3>Réseaux</h3></summary>
                <ul>
                    <li><a href=""><i class="fa-brands fa-instagram"></i> Instagram</a></li>
                    <li><a href=""><i class="fa-brands fa-x-twitter"></i> Twitter</a></li>
                    <li><a href=""><i class="fa-brands fa-youtube"></i> Youtube</a></li>
                </ul>
            </details>
        </div>
        <div style="max-width: 300px; margin:3rem auto;">
            <a class="alert alert-primary" href="{{ path('app_accueil') }}" > <- Retour en page d'accueil </a>
        </div>

    </section>
    {% endblock %}
