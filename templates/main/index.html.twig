{% extends 'base.html.twig' %}

{% block body %}

    <main>
        <header  >
            <div class="main_header">
                <h2> Bienvenue sur votre site de cinéphiles !!</h2>
                <p>
                    Plongez au cœur du 7ᵉ art : critiques, résumés, analyses et coups de cœur autour des plus grands classiques comme des nouveautés. Ici, le cinéma se vit, se partage et se redécouvre à travers toutes ses émotions.
                </p>
            </div>
        </header>
        <h3>Les dernières sorties :</h3>
            <article class="card" style="margin: 2rem;">
                {% for classique in Classiques %}
                    <div class="card-header">
                        <h3 > Titre : {{ classique.nom }}</h3>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title"> Réalisateur : {{ classique.realisateurs }}</h4>
                        <p > Description : {{ classique.description }}</p>
                        <p> Date de sortie : {{ classique.datedesortie|date('d/m/Y')}}</p>
                        <p> Genre : {{ classique.genre}}</p>
                        <p> Durée : {{ classique.duree}} min</p>
                    </div>
                {% endfor %}
            </article>
    </main>
{% endblock %}
