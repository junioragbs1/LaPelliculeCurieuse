{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %} <title> Donnez une note ✅</title>{% endblock %}

{% block body %}

    <div class="example-wrapper">
        <p> Choisissez un Film ou une Série :</p>

        {{ form_start(form) }}
        <div class="input">
            {{ form_row(form.note, { 'label': 'Votre note : ' }) }}
        </div>
        <div class="input">
            {{ form_row(form.id_film, { 'label': 'Choisissez un film : ' }) }}
        </div>
        <div class="input">
            {{ form_row(form.id_serie, { 'label': 'Choisissez une série : ' }) }}
        </div>

        <button type="submit">Ajouter</button>

        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_profile') }}">← Retour à la liste</a>
{% endblock %}
