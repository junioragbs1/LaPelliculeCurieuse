{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %} <title> Donnez une note ✅</title>{% endblock %}

{% block body %}

    <div class="example-wrapper">
        <p> Choisissez un Film ou une Série :</p>

        {{ form_start(form) }}

            {{ form_row(form.note, {
                'label': 'Votre note :',
                'attr': { 'class': 'mon-input' }
            }) }}
            {{ form_row(form.id_film, {
                'label': 'Choisissez un film : ',
                'attr': { 'class': 'mon-input' }
            }) }}
            {{ form_row(form.id_serie, {
                'label': 'Choisissez une série : ',
                'attr': { 'class': 'mon-input' }
            }) }}

        <button type="submit" class="btn">Ajouter</button>

        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_profile') }}" class="return">← Retour à la liste</a>
{% endblock %}
