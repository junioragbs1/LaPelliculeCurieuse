{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %} <title> Donnez une note ✅</title>{% endblock %}

{% block body %}

    <div class="formulaire">
        <h2 class="connect"> Choisissez un Film ou une Série :</h2>

        {{ form_start(form) }}

            {{ form_row(form.note, {
                'label': 'Votre note :',
                'attr': { 'class': 'mon-input' }
            }) }}
            {{ form_row(form.id_film, {
                'label': 'Choisissez un film : ',
                'attr': { 'class': 'mon-input' }
            }) }}
            {{ form_row(form.id_serie, {
                'label': 'Choisissez une série : ',
                'attr': { 'class': 'mon-input' }
            }) }}

        {{ form_end(form) }}
        <button type="submit" class="btn">Ajouter</button>

        <a href="{{ path('app_profile') }}" class="btn">← Retour à la liste</a>
    </div>

{% endblock %}
