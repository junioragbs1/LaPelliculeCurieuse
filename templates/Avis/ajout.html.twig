{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}Donnez une note ✅{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    </style>

    <div class="example-wrapper">
        <p> Choisissez un Film ou une Série :</p>

        {# Formulaire #}

        {{ form_start(form) }}

        {{ form_row(form.note, { 'label': 'Votre note : ' }) }}
        {{ form_row(form.id_film, { 'label': 'Choisissez un film : ' }) }}
        {{ form_row(form.id_serie, { 'label': 'Choisissez une série : ' }) }}

        <button type="submit">Ajouter</button>

        {{ form_end(form) }}
    </div>

    <a href="{{ path('app_profile') }}">← Retour à la liste</a>
{% endblock %}
