{% block title %}
    <title>Ajouter un film </title>
{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}


    <div class="formulaire">
        {{ form_start(form) }}

        <h2 class="connect"> Ajouter un film</h2>

            {{ form_row(form.titre, {
                'label': 'Titre :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.description, {
                'label': 'Description :',
                'attr': {'class': 'mon-input', 'rows': 4},
            }) }}

            {{ form_row(form.genre, {
                'label': 'Choisissez un genre :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.dateDeSortie, {
                'label': 'Date de sortie :',
                'attr': {'class': 'mon-input'},
            }) }}

            {{ form_row(form.duree, {
                'label': 'Durée (en minutes) :',
                'attr': {'class': 'mon-input'}
            }) }}

            {{ form_row(form.realisateurs, {
                'label': 'Réalisateurs :',
                'attr': {'class': 'mon-input'}
            }) }}


            {{ form_row(form.affiche, {
                'label': 'Affiche du film :', 'attr': {'class': 'file'}
            }) }}



        {{ form_end(form) }}

    <button type="submit" class="btn">
        Ajouter le film
    </button>
    <a href="{{ path('app_profile') }}" class="btn">← Retour à la liste</a>
    </div>

{% endblock %}
