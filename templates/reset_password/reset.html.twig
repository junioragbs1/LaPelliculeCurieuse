{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}<title> Réinitialiser votre mot de passe</title>{% endblock %}

{% block body %}

<div class="container">
    {{ form_start(resetForm) }}


    <div class="input">
        {{
        form_row(resetForm.plainPassword , {
            'label' : 'Saisissez votre nouveau mot de passe : '
        })
        }}
    </div>

        <button class="btn-envoie">Réinitialiser le mot de passe</button>
    {{ form_end(resetForm) }}
</div>
{% endblock %}
