{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}<title> Reinitialiser votre mot de passe</title>{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <div class="container">
        <h1 class="request">Demande de réinitialision de votre mot de passe</h1>

        {{ form_start(requestForm) }}
        <div class="small">
            <p>
                Saisissez votre adresse e-mail pour réinitialiser votre mot de passe.
            </p>
        </div>

        <div class="input">
            {{ form_row(requestForm.email, { 'label': 'Email : ' }) }}
        </div>


        <button class="btn-envoie">Envoyer le mail de réinitialision</button>
        {{ form_end(requestForm) }}
    </div>
{% endblock %}
