{% block title %}
    <title> Inscription</title>
{% endblock %}
{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
{% endblock %}

{% block body %}
    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, {
        'attr': { 'class': 'card shadow p-4', 'style': 'max-width:600px; margin:3rem auto;' }
    }) }}

    <h2 class="mb-4 text-center text-primary"> Créer un compte</h2>

    <div class="mb-3">
        {{ form_row(registrationForm.nom, {
            'label': 'Nom',
            'attr': {'class': 'form-control'}
        }) }}
    </div>

    <div class="mb-3">
        {{ form_row(registrationForm.prenom, {
            'label': 'Prénom',
            'attr': {'class': 'form-control'}
        }) }}
    </div>

    <div class="mb-3">
        {{ form_row(registrationForm.email, {
            'label': 'Adresse email',
            'attr': {'class': 'form-control'}
        }) }}
    </div>

    <div class="mb-3">
        {{ form_row(registrationForm.plainPassword, {
            'label': 'Mot de passe',
            'attr': {'class': 'form-control'}
        }) }}
    </div>

    <div class="form-check mb-3">
        {{ form_row(registrationForm.agreeTerms, {
            'label': 'J’accepte les conditions',
            'attr': {'class': 'form-check-input'}
        }) }}
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-success btn-lg">
            M'inscrire
        </button>
    </div>

    {{ form_end(registrationForm) }}

    <div class="text-center mt-4" style="max-width: 600px; margin: auto;">
        <p>Déjà inscrit ?
            <a href="{{ path('app_login') }}" class="text-decoration-none text-primary fw-bold">
                Me connecter
            </a>
        </p>

        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_accueil') }}">
            ← Retour à l'accueil
        </a>
    </div>

{% endblock %}
