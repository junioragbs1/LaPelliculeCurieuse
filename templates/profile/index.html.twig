{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <header>
        <nav>
            <a href="{{ path('app_profile') }}"><img src="{{ asset('assets/images/logo.png') }}" alt="logo site"></a>
            <ul>
                <li><a href="{{ path('app_contacts') }}">Contact</a></li>
                <li><a href="{{ path('app_mon_compte') }}">Mon compte</a></li>
                <li><a href="{{ path('app_logout') }}"><i class="fa-solid fa-arrow-right-from-bracket"></i>Deconnexion</a></li>
            </ul>
        </nav>
    </header>
<div class="content">
        <main>
            <div class="profile">
                <h2> Bienvenue {{ app.user.nom }} {{ app.user.prenom }}</h2>
                <div class="entete">
                    <p> Vous voulez ajouter : </p>
                    <a href="{{ path('app_films_ajout') }}"> Un film ? </a>
                    <a href="{{ path('app_series_ajout') }}"> Une serie ? </a>
                </div>
                    <input type="search" id="site-search" name="q" /> <button>Rechercher </button>
            </div>

            <section>
                <h2>Series :</h2>
                <p>
                    Plongez dans l’univers des séries : suspens haletant, comédies irrésistibles, drames intenses ou aventures fantastiques. Découvrez les dernières nouveautés, les classiques incontournables et laissez-vous captiver épisode après épisode.
                </p>
                <article class="series">
                    <article class="series">
                        {% for serie in series %}
                            <div class="serie-card">
                                <h3> {{ serie.titre }} par {{ serie.realisateurs }} </h3>
                                 <img src="{{ asset('assets/images/LPC.png') }}" alt="logo film" class="serie-img">
                                <p><strong>Description :</strong> {{ serie.description }}</p>
                                <p><strong>Date de sortie :</strong> {{ serie.datedesortie|date('d/m/Y') }}</p>
                                <p><strong>Genre :</strong> {{ serie.genre }}</p>
                                <p><strong>Durée :</strong> {{ serie.duree }} min par épisode</p>
                                <p><strong>Ajouté par :</strong> <small>{{ app.user.prenom }} {{ app.user.nom }}</small></p>

                                <p><strong>Avis :</strong></p>
                                <ul>
                                    {% for avis in serie.serieAvis %}
                                        <li>Note : {{ avis.note }} par {{ avis.idUtilisateur.nom }}</li>
                                    {% else %}
                                        <li>Aucun avis pour cette série.</li>
                                    {% endfor %}
                                </ul>
                                <a href="{{ path('app_contacts_ajout') }}" class="btn-avis">Ajouter un avis</a>
                            </div>
                        {% endfor %}
                    </article>

                </article>
            </section>

            <section>
                <h2>Films :</h2>
                <p>
                    Découvrez notre collection de films pour tous les goûts : classiques incontournables, nouveautés captivantes et pépites méconnues. Parcourez, explorez et laissez-vous inspirer par des histoires qui vous feront rire, pleurer, frissonner ou rêver.
                </p>
                <article class="films">
                    <article class="films">
                        {% for film in films %}
                            <div class="film-card">
                                <h3>{{ film.titre }} par {{ film.realisateurs }}</h3>
                                <img src="{{ asset('assets/images/Pulp_Fiction .jpg') }}" alt="logo film" class="film-img">

                                <p><strong>Description :</strong> {{ film.description }}</p>
                                <p><strong>Date de sortie :</strong> {{ film.datedesortie|date('d/m/Y') }}</p>
                                <p><strong>Genre :</strong> {{ film.genre }}</p>
                                <p><strong>Durée :</strong> {{ film.duree }} min</p>
                                <p><strong>Ajouté par :</strong> <small>{{ app.user.prenom }} {{ app.user.nom }}</small></p>

                                <p><strong>Avis :</strong></p>
                                <ul>
                                    {% for avis in film.filmAvis %}
                                        <li>Note : {{ avis.note }} par {{ avis.idUtilisateur.nom }}</li>
                                    {% else %}
                                        <li>Aucun avis pour ce film.</li>
                                    {% endfor %}
                                </ul>
                                <a href="{{ path('app_contacts_ajout') }}" class="btn-avis">Ajouter un avis</a>
                            </div>
                        {% endfor %}
                    </article>

                </article>
            </section>
        </main>
</div>
    {% block javascripts %}
        <script src="https://kit.fontawesome.com/9dafe03bf9.js" crossorigin="anonymous"></script>
    {% endblock %}
{% endblock %}
